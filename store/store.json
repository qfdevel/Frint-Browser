{
  "name": "Frint Plugin/Theme Store",
  "version": "1.0.0",
  "description": "Official store for Frint Browser themes and extensions",
  "store_url": "https://store.frintbrowser.dev",
  "themes": [
    {
      "id": "catppuccin-mocha",
      "name": "Catppuccin Mocha",
      "version": "1.0.0",
      "author": "Frint Team",
      "description": "Catppuccin Mocha dark theme with warm, cozy tones",
      "type": "theme",
      "files": ["catppuccin-mocha.css"],
      "screenshot": "screenshots/catppuccin-mocha.png",
      "license": "MIT",
      "compatibility": ">=0.1.0"
    },
    {
      "id": "nord-dark",
      "name": "Nord Dark",
      "version": "1.0.0",
      "author": "Frint Team",
      "description": "Arctic, bluish dark theme inspired by Nord palette",
      "type": "theme",
      "files": ["nord-dark.css"],
      "screenshot": "screenshots/nord-dark.png",
      "license": "MIT",
      "compatibility": ">=0.1.0"
    },
    {
      "id": "gruvbox-material",
      "name": "Gruvbox Material",
      "version": "1.0.0",
      "author": "Frint Team",
      "description": "Warm retro theme based on the Gruvbox color palette",
      "type": "theme",
      "files": ["gruvbox-material.css"],
      "screenshot": "screenshots/gruvbox-material.png",
      "license": "MIT",
      "compatibility": ">=0.1.0"
    }
  ],
  "extensions": [
    {
      "id": "dark-reader",
      "name": "Dark Reader",
      "version": "1.0.0",
      "author": "Frint Team",
      "description": "Apply dark mode to all websites",
      "type": "extension",
      "permissions": ["storage", "content-scripts"],
      "files": ["dark-reader.js", "dark-reader.css"],
      "license": "MIT",
      "compatibility": ">=0.1.0"
    },
    {
      "id": "ublock-lite",
      "name": "uBlock Lite",
      "version": "1.0.0",
      "author": "Frint Team",
      "description": "Lightweight ad and tracker blocker",
      "type": "extension",
      "permissions": ["web-request", "storage", "content-scripts"],
      "files": ["ublock-lite.js", "filters.txt"],
      "license": "GPL-3.0",
      "compatibility": ">=0.1.0"
    },
    {
      "id": "privacy-badger",
      "name": "Privacy Badger",
      "version": "1.0.0",
      "author": "Frint Team",
      "description": "Learn and block invisible trackers",
      "type": "extension",
      "permissions": ["web-request", "storage", "cookies"],
      "files": ["privacy-badger.js"],
      "license": "GPL-3.0",
      "compatibility": ">=0.1.0"
    }
  ]
}
